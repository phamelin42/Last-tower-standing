static var _cache: Dictionary = {}


## Boîte de l'image `image` du modèle `cle` (vide si inconnue).
static func boite(cle: String, image: int) -> Rect2i:
	if not BOITES.has(cle):
		return Rect2i()
	var boites: Array = BOITES[cle]
	if image < 0 or image >= boites.size():
		return Rect2i()
	var texte: String = boites[image]
	if not _cache.has(texte):
		var v: PackedFloat64Array = texte.split_floats(",")
		_cache[texte] = Rect2i(int(v[0]), int(v[1]), int(v[2]), int(v[3]))
	return _cache[texte]
